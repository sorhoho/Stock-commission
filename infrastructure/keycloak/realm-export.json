{
  "realm": "telco",
  "displayName": "Telco Distribution & Commission",
  "enabled": true,
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 300,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "telco-services",
      "name": "Telco Backend Services (M2M)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "telco-services-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "telco-frontend",
      "name": "Telco Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://frontend:80/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://frontend"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "sell_out:create",
        "sell_out:read",
        "commission_rules:read",
        "commission_rules:write",
        "commission_statement:read",
        "commission_statement:confirm",
        "party:read",
        "party:write",
        "inventory:read",
        "inventory:write",
        "payout:create",
        "payout:admin",
        "audit:read",
        "admin"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "party_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "party_id",
            "claim.name": "party_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "telco-services-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "telco-services",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "inventory:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "inventory:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
